PORT=4000
# Set to "production" on the deploy host — enables strict env validation.
NODE_ENV=development

# Local MongoDB for dev; MongoDB Atlas connection string in production.
MONGODB_URI=mongodb://127.0.0.1:27017/healingsathi

# Generate strong values for production:  openssl rand -hex 32
# The server refuses to boot in production while these contain "change-me".
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# Comma-separated browser origins allowed by CORS, e.g. https://healingsathi.com
# Leave empty to allow all (dev). Native mobile apps are unaffected either way.
CORS_ORIGIN=

# --- Outbound email (password-reset + sign-in codes) ---
# Gmail for dev: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_USER=you@gmail.com,
# SMTP_PASS=<App Password from myaccount.google.com/apppasswords (needs 2FA)>.
# Leave empty to log codes to the console (dev builds also receive them as devCode).
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM="HealingSathi <you@gmail.com>"

# --- Google Sign-In ---
# Comma-separated OAuth client IDs (Web client ID, iOS client ID) from
# console.cloud.google.com → APIs & Services → Credentials.
# Empty = the /auth/google endpoint answers 501 (feature off).
GOOGLE_CLIENT_IDS=

PORT=4000
# Set to "production" on the deploy host — enables strict env validation.
NODE_ENV=development

# Local MongoDB for dev; MongoDB Atlas connection string in production.
MONGODB_URI=mongodb://127.0.0.1:27017/healingsathi

# Generate strong values for production:  openssl rand -hex 32
# The server refuses to boot in production while these contain "change-me".
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# Comma-separated browser origins allowed by CORS, e.g. https://healingsathi.com
# Leave empty to allow all (dev). Native mobile apps are unaffected either way.
CORS_ORIGIN=

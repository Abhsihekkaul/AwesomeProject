generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────────────────
// Users
// ─────────────────────────────────────────────────────────────────────────

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  passwordHash String?
  name      String
  avatarColor String @default("#7453C8")
  avatarUrl String?
  bio       String?

  // Privacy / settings (SettingsScreen.tsx)
  publicProfile   Boolean @default(false)
  showConditions  Boolean @default(true)
  anonymousPosts  Boolean @default(false)
  analyticsOptIn  Boolean @default(true)
  researchOptIn   Boolean @default(false)

  // Notification prefs (SettingsScreen.tsx)
  notifyGroupActivity Boolean @default(true)
  notifyReplies       Boolean @default(true)
  notifyMatches       Boolean @default(true)
  notifyConsultants   Boolean @default(true)

  conditions Condition[]

  posts           Post[]
  postReactions   PostReaction[]
  shareEvents     ShareEvent[]
  comments        Comment[]
  commentVotes    CommentVote[]

  groupMemberships GroupMembership[]
  groupProposals   GroupProposal[]
  createdGroups    Group[]           @relation("GroupCreator")

  conversations ConversationParticipant[]
  sentMessages  Message[]

  healerProfile HealerProfile?
  reviewsWritten Review[]
  bookingsAsPatient Booking[] @relation("PatientBookings")

  notifications Notification[]
  refreshTokens RefreshToken[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model RefreshToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String
  expiresAt DateTime
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
}

enum ConditionCategory {
  DiabetesMetabolic
  Cardiovascular
  MentalHealth
  Neurological
  Autoimmune
  Digestive
  Respiratory
  PainChronic
  EndocrineHormonal
  KidneyUrinary
  Cancer
  Skin
  RareOther
}

model Condition {
  id       String            @id @default(cuid())
  name     String            @unique
  category ConditionCategory
  users    User[]
}

// ─────────────────────────────────────────────────────────────────────────
// Groups / Posts / Threaded Comments
// ─────────────────────────────────────────────────────────────────────────

enum GroupStatus {
  Active
  PendingReview
}

model Group {
  id            String      @id @default(cuid())
  name          String      @unique
  description   String
  category      String
  accentColor   String      @default("#4E79C7")
  status        GroupStatus @default(Active)

  createdById   String
  createdBy     User        @relation("GroupCreator", fields: [createdById], references: [id])

  memberships GroupMembership[]
  posts       Post[]

  createdAt DateTime @default(now())
}

enum GroupRole {
  Member
  Moderator
  Contributor
  Admin
}

model GroupMembership {
  id      String    @id @default(cuid())
  userId  String
  user    User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  groupId String
  group   Group     @relation(fields: [groupId], references: [id], onDelete: Cascade)
  role    GroupRole @default(Member)

  joinedAt DateTime @default(now())

  @@unique([userId, groupId])
  @@index([groupId])
}

enum GroupProposalStatus {
  Pending
  Approved
  Rejected
}

model GroupProposal {
  id                  String               @id @default(cuid())
  requestedById        String
  requestedBy          User                 @relation(fields: [requestedById], references: [id], onDelete: Cascade)
  conditionName        String
  briefDescription     String
  estimatedPopulation  String?
  whyNeeded            String
  medicalReferences    String?
  status               GroupProposalStatus  @default(Pending)
  createdAt            DateTime             @default(now())
}

enum PostReactionType {
  Support
  Helpful
}

model Post {
  id        String   @id @default(cuid())
  authorId  String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  groupId   String?
  group     Group?   @relation(fields: [groupId], references: [id], onDelete: SetNull)

  title     String?
  body      String
  tags      String[]
  contentWarning Boolean @default(false)
  images    String[]
  videoUrl  String?

  supportCount Int @default(0)
  helpfulCount Int @default(0)
  commentCount Int @default(0)
  shareCount   Int @default(0)

  reactions PostReaction[]
  shares    ShareEvent[]
  comments  Comment[]

  createdAt DateTime @default(now())

  @@index([groupId])
  @@index([authorId])
}

model PostReaction {
  id     String           @id @default(cuid())
  postId String
  post   Post             @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId String
  user   User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type   PostReactionType

  createdAt DateTime @default(now())

  @@unique([postId, userId, type])
}

model ShareEvent {
  id     String @id @default(cuid())
  postId String
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([postId])
}

model Comment {
  id       String    @id @default(cuid())
  postId   String
  post     Post      @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorId String
  author   User      @relation(fields: [authorId], references: [id], onDelete: Cascade)

  parentId String?
  parent   Comment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies  Comment[] @relation("CommentReplies")

  depth     Int    @default(0)
  text      String
  voteCount Int    @default(0)

  votes CommentVote[]

  createdAt DateTime @default(now())

  @@index([postId, parentId])
}

model CommentVote {
  id        String  @id @default(cuid())
  commentId String
  comment   Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  value     Int

  @@unique([commentId, userId])
}

// ─────────────────────────────────────────────────────────────────────────
// Chat
// ─────────────────────────────────────────────────────────────────────────

model Conversation {
  id           String                     @id @default(cuid())
  participants ConversationParticipant[]
  messages     Message[]

  createdAt DateTime @default(now())
}

model ConversationParticipant {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  lastReadAt     DateTime     @default(now())

  @@unique([conversationId, userId])
  @@index([userId])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User         @relation(fields: [senderId], references: [id], onDelete: Cascade)
  text           String
  attachmentUrl  String?

  createdAt DateTime @default(now())

  @@index([conversationId, createdAt])
}

// ─────────────────────────────────────────────────────────────────────────
// Consultants / Booking
// ─────────────────────────────────────────────────────────────────────────

enum SessionType {
  Video
  Audio
  Chat
}

model HealerProfile {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  title        String
  bio          String
  specialties  String[]
  languages    String[]
  sessionTypes SessionType[]
  priceMin     Int
  priceMax     Int
  currency     String  @default("USD")

  ratingAvg   Float @default(0)
  reviewCount Int   @default(0)
  verified    Boolean @default(false)

  availabilityRules AvailabilityRule[]
  slots             Slot[]
  reviews           Review[]
  bookings          Booking[]

  createdAt DateTime @default(now())
}

model Review {
  id       String        @id @default(cuid())
  healerId String
  healer   HealerProfile @relation(fields: [healerId], references: [id], onDelete: Cascade)
  authorId String
  author   User          @relation(fields: [authorId], references: [id], onDelete: Cascade)
  stars    Int
  text     String

  createdAt DateTime @default(now())

  @@unique([healerId, authorId])
}

model AvailabilityRule {
  id          String        @id @default(cuid())
  healerId    String
  healer      HealerProfile @relation(fields: [healerId], references: [id], onDelete: Cascade)
  dayOfWeek   Int // 0 (Sunday) - 6 (Saturday)
  startTime   String // "09:00"
  endTime     String // "17:00"
  sessionType SessionType
  slotMinutes Int           @default(60)
  isActive    Boolean       @default(true)

  createdAt DateTime @default(now())
}

enum SlotStatus {
  Open
  Booked
  Cancelled
}

model Slot {
  id          String        @id @default(cuid())
  healerId    String
  healer      HealerProfile @relation(fields: [healerId], references: [id], onDelete: Cascade)
  startAt     DateTime
  endAt       DateTime
  sessionType SessionType
  status      SlotStatus    @default(Open)

  booking Booking?

  createdAt DateTime @default(now())

  @@index([healerId, startAt])
}

enum BookingStatus {
  Pending
  Confirmed
  Completed
  Cancelled
  NoShow
}

model Booking {
  id          String        @id @default(cuid())
  slotId      String        @unique
  slot        Slot          @relation(fields: [slotId], references: [id], onDelete: Cascade)
  patientId   String
  patient     User          @relation("PatientBookings", fields: [patientId], references: [id], onDelete: Cascade)
  healerId    String
  healer      HealerProfile @relation(fields: [healerId], references: [id], onDelete: Cascade)
  sessionType SessionType
  status      BookingStatus @default(Pending)
  notes       String?

  createdAt   DateTime  @default(now())
  cancelledAt DateTime?

  @@index([patientId])
  @@index([healerId])
}

// ─────────────────────────────────────────────────────────────────────────
// Notifications
// ─────────────────────────────────────────────────────────────────────────

enum NotificationType {
  Groups
  Chats
  System
  Booking
}

model Notification {
  id     String            @id @default(cuid())
  userId String
  user   User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  type   NotificationType
  title  String
  message String

  deepLinkType String?
  deepLinkId   String?

  read Boolean @default(false)

  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

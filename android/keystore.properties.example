# Copy this file to "keystore.properties" (same folder) and fill in real values.
# "keystore.properties" itself is gitignored — never commit your real signing credentials.
#
# To generate a real release keystore (only needs to be done once, ever — losing this file
# means you can never update your app on the Play Store under the same listing again):
#
#   keytool -genkeypair -v -storetype PKCS12 \
#     -keystore healingsathi-release.keystore \
#     -alias healingsathi -keyalg RSA -keysize 2048 -validity 10000
#
# Put the generated .keystore file somewhere OUTSIDE version control (e.g. android/app/)
# and reference it below.

storeFile=healingsathi-release.keystore
storePassword=CHANGE_ME
keyAlias=healingsathi
keyPassword=CHANGE_ME
